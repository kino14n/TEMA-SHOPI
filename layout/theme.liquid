    <!-- Script de Depuración y Rendimiento (Global Error Handler) -->
    <script>
      (function() {
        var perfStart = performance.now();
        window.addEventListener('DOMContentLoaded', function() {
          var domReady = performance.now() - perfStart;
          console.log('[Depuración de Carga] DOMContentLoaded:', domReady.toFixed(2) + 'ms');
        });
        window.addEventListener('load', function() {
          var fullLoad = performance.now() - perfStart;
          console.log('[Depuración de Carga] Full Load:', fullLoad.toFixed(2) + 'ms');
        });

        // Captura global de errores
        window.addEventListener('error', function(event) {
          console.error('[Error Global Capturado]', {
            mensaje: event.message,
            archivo: event.filename,
            linea: event.lineno,
            columna: event.colno,
            errorObj: event.error
          });
        });
      })();
    </script>
